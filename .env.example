# Twitch Chat Scraper Configuration

# Twitch API Credentials (required for channel discovery)
CLIENT_ID=your_twitch_client_id_here
CLIENT_SECRET=your_twitch_client_secret_here

# ============================================
# Scraper Configuration
# ============================================
# Channels to monitor. 0 (the default) means no limit: every channel discovery
# returns above the viewer floor is monitored, and connections are added as
# Twitch brings more channels online.
# MAX_CHANNELS=0
# CHANNELS_PER_CONNECTION=1500
# JOINs per second across all connections. Twitch silently drops JOINs above
# roughly 100/s from one IP; unconfirmed JOINs are retried.
# JOINS_PER_SECOND=50
# METRICS_PORT=9091

# ============================================
# Database Configuration
# ============================================
# Choose your database type: sqlite, postgres, or clickhouse
DB_TYPE=sqlite

# ============================================
# SQLite Configuration (default)
# ============================================
# Path to SQLite database file
DB_PATH=./chat_messages.db

# ============================================
# PostgreSQL Configuration
# ============================================
# Uncomment and configure these if using PostgreSQL
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_NAME=twitch_chat
# DB_SSLMODE=disable

# ============================================
# ClickHouse Configuration
# ============================================
# Uncomment and configure these if using ClickHouse
# DB_TYPE=clickhouse
# DB_HOST=localhost
# DB_PORT=9000
# DB_USER=default
# DB_PASSWORD=your_clickhouse_password
# DB_NAME=twitch_chat

# ClickHouse uses per-table batching by default; SQLite/Postgres use legacy.
# Use DB_BATCH_MODE=legacy to restore 500 mixed rows / 1s and immediate snapshots.
# DB_BATCH_MODE=table
# DB_BATCH_MESSAGE_ROWS=5000
# DB_BATCH_MESSAGE_INTERVAL=5s
# DB_BATCH_EVENT_ROWS=1000
# DB_BATCH_EVENT_INTERVAL=30s
# DB_BATCH_SNAPSHOT_ROWS=1000
# DB_BATCH_SNAPSHOT_INTERVAL=10s
# DB_BATCH_MAX_BYTES=33554432

# ============================================
# Example Configurations
# ============================================

# Example 1: SQLite (simplest, no setup required)
# DB_TYPE=sqlite
# DB_PATH=./chat_messages.db

# Example 2: PostgreSQL (recommended for production)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=twitch_scraper
# DB_PASSWORD=secure_password_here
# DB_NAME=twitch_chat
# DB_SSLMODE=require

# Example 3: ClickHouse (best for high-volume analytics)
# DB_TYPE=clickhouse
# DB_HOST=localhost
# DB_PORT=9000
# DB_USER=default
# DB_PASSWORD=secure_password_here
# DB_NAME=twitch_chat
